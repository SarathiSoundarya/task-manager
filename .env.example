# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored. Never commit real tokens.

# --- Supabase project identity (used by the supabase CLI for `db push`, `functions deploy`, etc.) ---
# Project ref: the subdomain in your project URL (e.g. abcdefghij.supabase.co → SUPABASE_PROJECT_REF=abcdefghij)
SUPABASE_PROJECT_REF=

# Personal access token. Generate at https://supabase.com/dashboard/account/tokens
# Used by the Supabase CLI and the Claude Code Supabase MCP server.
SUPABASE_ACCESS_TOKEN=

# --- Groq (used by the edge function — set this as a Supabase secret too, see README) ---
# Generate at https://console.groq.com/keys
GROQ_API_KEY=

# --- Netlify (only needed if you use the Netlify CLI / MCP locally) ---
# Generate at https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_AUTH_TOKEN=
