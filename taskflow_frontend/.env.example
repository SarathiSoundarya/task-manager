# Copy this file to `.env.local` and fill in your own values.
# `.env.local` is gitignored. These are PUBLIC values (the browser ships them),
# but we still keep them out of git so the repo isn't bound to one project.

# Find both at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
